#!/bin/sh
# Git pre-push hook: blocks any push (VS Code, terminal, or Claude) if a
# tracked file contains an email address. Enable once per clone with:
#   git config core.hooksPath .githooks

# PowerShell 7 (pwsh) on macOS/Linux, or if installed; else Windows PowerShell.
if command -v pwsh >/dev/null 2>&1; then
    ps=pwsh
else
    ps=powershell.exe
fi

"$ps" -NoProfile -ExecutionPolicy Bypass -File "$(git rev-parse --show-toplevel)/scripts/check-emails.ps1"
